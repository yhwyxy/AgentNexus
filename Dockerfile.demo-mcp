# 示例 MCP 后端镜像:用于 Compose 与 docker provider 的端到端冒烟。
FROM golang:1.27-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/demo-mcp ./cmd/demo-mcp

FROM alpine:3.21

RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 demo \
    && mkdir -p /workspace \
    && chown demo:demo /workspace

COPY --from=build /out/demo-mcp /usr/local/bin/demo-mcp

ENV DEMO_MCP_READ_ROOT=/workspace
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/demo-mcp"]
CMD ["-transport", "http", "-addr", "0.0.0.0:8080", "-path", "/mcp"]
